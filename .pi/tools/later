#!/usr/bin/env python3
# ---
# description = "Leave yourself a prompt that comes back to this checkout as a turn of its own, after a delay or on a period. It arrives once nothing else is running, so end this turn rather than wait for it. Give `prompt` and one of `after` or `every`. It lasts while pi runs; `bash` lists it and stops it. To come back when a command ends, run it with bash's `background` instead."
# background = true
# [required]
# prompt = "What to do when it comes due, written as a request: it arrives with nothing of this turn but what you put in it."
# [optional]
# after = "a delay, 30s / 10m / 2h / 1d"
# every = "a period, at least 1m"
# ---
# A timer service submits each occurrence as a canonical automatic input.
import json
import os
import sys
import time
import uuid

UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def span(spec):
    unit, count = spec[-1:], spec[:-1].strip()
    if unit not in UNITS or not count.isdigit():
        fail(f"`{spec}` is not a span like 30s, 10m, 2h or 1d")
    seconds = int(count) * UNITS[unit]
    if seconds > 365 * 86400:
        fail(f"`{spec}` is longer than a year")
    return seconds


def say(fd3, frame):
    fd3.write(json.dumps(frame) + "\n")
    fd3.flush()


def status(fd3, text):
    say(fd3, {"op": "status", "text": text})


def initialize(fd3, replies):
    say(fd3, {"id": "hello", "op": "initialize", "protocol": 4})
    answer(fd3, replies, "hello")


def answer(fd3, replies, wanted):
    while True:
        line = replies.readline()
        if not line:
            fail("host frame connection closed")
        reply = json.loads(line)
        if "error" in reply and "id" not in reply:
            fail(reply["error"].get("message") or "the host refused a frame")
        if reply.get("id") != wanted:
            continue
        if "error" in reply:
            fail(reply["error"].get("message") or "the host refused the frame")
        return reply.get("result") or {}


def trigger(fd3, replies, prompt, source):
    message_id = uuid.uuid4().hex
    say(fd3, {
        "id": message_id,
        "op": "say",
        "text": prompt,
        "as": "task",
        "source": source,
        "reason": "timer elapsed",
    })
    answer(fd3, replies, message_id)


def main():
    if os.environ.get("PI_EVENTS_FD") != "3":
        fail("later needs pi to keep it running: no fd 3 here")
    fd3 = os.fdopen(os.dup(3), "w")
    replies = os.fdopen(os.dup(3), "r")
    initialize(fd3, replies)
    args = json.load(sys.stdin)
    prompt = (args.get("prompt") or "").strip()
    after = (args.get("after") or "").strip()
    every = (args.get("every") or "").strip()
    if not prompt:
        fail("`prompt` says what to do when it comes due")
    if bool(after) == bool(every):
        fail("give exactly one of `after` or `every`")

    source = "timer:" + uuid.uuid4().hex
    if after:
        seconds = span(after)
        status(fd3, f"set: back in {after}, so this turn can end")
        time.sleep(seconds)
        trigger(fd3, replies, prompt, source)
        return
    seconds = span(every)
    if seconds < 60:
        fail("`every` is at least 1m")
    status(fd3, f"set: back every {every} until stopped, so this turn can end")
    while True:
        status(fd3, f"next in {every}")
        time.sleep(seconds)
        trigger(fd3, replies, prompt, source)


main()
