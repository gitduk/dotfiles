#!/usr/bin/env python3
# ---
# description = "Read the text out of an image — a screenshot, a photo of a page, a diagram's labels — and answer with that text, lines in their original order. Not OCR-only: a vision model reads it, so layout, tables and CJK come through. Fails with the reason when the file is missing, the type is not an image, or the model is unreachable."
# [required]
# image = "path of the image to read, absolute or relative to the workspace (e.g. /home/wukaige/.pi/images/1791431570406.png)"
# ---
"""Transcribe an image through pi's own Bifrost gateway.

The gateway (2026-11-26: :8080, OpenAI-compatible Chat Completions) needs a
virtual key and upstream-prefixed model ids, so the request format is chat
completions, not the Anthropic messages API the old :7896 proxy took.
`opencode-go/claude-haiku-5-5` transcribes Chinese screenshots accurately and
returns no thinking block, so its whole output budget goes to the text.
"""

import base64
import json
import os
import sys
import tomllib
import urllib.error
import urllib.request

PROVIDER = "bifrost"
MODEL = "opencode-go/claude-haiku-5-5"
SETTINGS = os.path.expanduser("~/.pi/settings.toml")
ENV_FILE = os.path.expanduser("~/.pi/.env")
TIMEOUT = 240
MEDIA_TYPES = {
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".gif": "image/gif",
    ".webp": "image/webp",
}
PROMPT = (
    "Transcribe every character of text in this image exactly as it appears, in the "
    "order it reads. Keep the wording, digits and punctuation as they are, do not "
    "translate, and add no commentary of your own. "
    "Do not open with a sentence about what you are doing, do not say the text would be "
    "long or that you are summarising, and do not summarise: the transcription alone, "
    "starting at the image's first line of text."
)


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def env_file():
    values = {}
    try:
        with open(ENV_FILE) as lines:
            for line in lines:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                name, _, value = line.partition("=")
                values[name.strip()] = value.strip().strip("\"'")
    except OSError:
        pass
    return values


def secret(reference):
    """`$NAME` reads the process environment first, then ~/.pi/.env, as pi does."""
    if not reference.startswith("$"):
        return reference
    name = reference[1:]
    return os.environ.get(name) or env_file().get(name) or fail(f"{name} is not set in the environment or {ENV_FILE}")


def gateway():
    """Base URL and virtual key of the `[provider.bifrost]` pi itself talks to."""
    try:
        with open(SETTINGS, "rb") as settings:
            provider = tomllib.load(settings).get("provider", {}).get(PROVIDER, {})
    except (OSError, tomllib.TOMLDecodeError) as error:
        fail(f"cannot read {SETTINGS}: {error}")
    if not provider.get("base_url"):
        fail(f"{SETTINGS} has no [provider.{PROVIDER}] base_url")
    return provider["base_url"].rstrip("/"), secret(provider.get("api_key", ""))


def media_type(path):
    extension = os.path.splitext(path)[1].lower()
    if extension not in MEDIA_TYPES:
        fail(
            f"{path}: {extension or 'no extension'} is not a supported image type; "
            f"convert it to one of {', '.join(sorted(MEDIA_TYPES))}"
        )
    return MEDIA_TYPES[extension]


def transcribe(path):
    try:
        with open(path, "rb") as image:
            encoded = base64.b64encode(image.read()).decode()
    except OSError as error:
        fail(f"cannot read {path}: {error.strerror or error}")

    base_url, key = gateway()
    payload = {
        "model": MODEL,
        "max_tokens": 16384,
        "messages": [
            {
                "role": "user",
                "content": [
                    {
                        "type": "image_url",
                        "image_url": {"url": f"data:{media_type(path)};base64,{encoded}"},
                    },
                    {"type": "text", "text": PROMPT},
                ],
            }
        ],
    }
    url = base_url + "/chat/completions"
    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={"content-type": "application/json", "authorization": f"Bearer {key}"},
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            answer = json.load(response)
    except urllib.error.HTTPError as error:
        fail(f"{url} answered {error.code}: {error.read().decode(errors='replace')[:500]}")
    except (urllib.error.URLError, OSError, ValueError) as error:
        fail(f"cannot reach the model at {url}: {error}")

    choice = (answer.get("choices") or [{}])[0]
    text = (choice.get("message") or {}).get("content") or ""
    if isinstance(text, list):
        text = "\n".join(part.get("text", "") for part in text if isinstance(part, dict))
    text = text.strip()
    if not text:
        # A model that thinks before answering spends the budget on the thinking block:
        # the answer comes back empty and finish_reason is length, not a missing image.
        finish = choice.get("finish_reason")
        if finish == "length" and (choice.get("message") or {}).get("reasoning_content"):
            fail(
                "the model spent its whole output budget thinking and returned no transcription; "
                f"raise max_tokens or drop the thinking block ({MODEL})"
            )
        fail(f"the model answered no text (finish_reason={finish}, keys={sorted(choice)})")
    print(text)
    if choice.get("finish_reason") == "length":
        print("[truncated: the model hit its output limit, the end of the text is missing]")


if __name__ == "__main__":
    argument = os.environ.get("image") or json.load(sys.stdin).get("image")
    if not argument:
        fail("no image argument was given")
    transcribe(argument)
