{
  "settings": {
    "mcpFooterStatus": "off"
  },
  "mcpServers": {
    "github": {
      "command": "bun",
      "args": ["x", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "chrome-headless": {
      "command": "bun",
      "args": ["x", "chrome-devtools-mcp@latest", "--headless", "--no-usage-statistics"]
    },
    "chrome-9222": {
      "command": "bun",
      "args": ["x", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222", "--no-usage-statistics"]
    },
    "filesystem": {
      "command": "bun",
      "args": ["x", "@modelcontextprotocol/server-filesystem", "/home/wukaige", "/tmp"]
    },
    "context7": {
      "command": "bun",
      "args": ["x", "@upstash/context7-mcp@latest"]
    }
  }
}
