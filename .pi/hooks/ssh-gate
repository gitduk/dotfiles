#!/usr/bin/env python3
# A `tool.before` gate for `bash`: an ssh call that can change the remote host
# runs only once you allow it. Reads, config queries and local forwards pass.
# What the rules below cannot place goes to `~/.pi/tools/judge`; a judgment it
# cannot give leaves the question asked.
#
#   [[hooks]]
#   on      = ["tool.before"]
#   tools   = ["bash"]
#   command = "~/.pi/hooks/ssh-gate"
import json
import os
import re
import shlex
import subprocess
import sys

# `ssh`, the paths to it, and its own `ssh-*` commands; not `ssh.txt`.
SSH = re.compile(r"(?<![\w.-])(?:[\w./+-]*/)?(ssh(?:-[a-z-]+)?)(?![\w.-])")

# Flags that take the next word, or an attached tail, as their value.
VALUE = set("BbcDEeFIiJLlmOoPpQRSWw")

# `-o` settings that hand the connection elsewhere or run outside it.
LIMITS = {
    "forwardagent",
    "localcommand",
    "permitlocalcommand",
    "proxycommand",
    "remotecommand",
    "remoteforward",
    "stricthostkeychecking",
    "userknownhostsfile",
}

# A duplicated file descriptor (`2>&1`), which writes nothing.
DUP = re.compile(r"\d*[<>]&\d+")

# The judgment tool, and where its key waits when the environment lacks one.
JUDGE = os.path.expanduser("~/.pi/tools/judge")
SECRETS = os.path.expanduser("~/.pi/tools/.env")

RISKY, SAFE, UNSURE = "risky", "safe", "unsure"

# Verbs that change the remote host wherever they run, and the words that make
# one of them only report (`systemctl status`, `docker ps`).
CHANGE = set("""
    apt apt-get dnf dd docker halt kill killall mkfs mv pacman pkill podman
    poweroff reboot rm service shutdown snap sudo su systemctl yum
""".split())
REPORT = set("""
    cat describe events images info inspect list logs ls ps show status version
""".split())

# A remote command whose first word only reports needs no question.
READ = set("""
    cat date df du echo env free grep head hostname id journalctl ls lsblk
    lscpu nproc pgrep ps pwd ss stat tail uname uptime wc whoami
""".split())


def scan(args):
    """The invocation's flags, its `-o` settings, and what is left over."""
    flags, options, bare = set(), [], []
    i = 0
    while i < len(args):
        word = args[i]
        i += 1
        if word == "-" or not word.startswith("-"):
            bare = [word] + args[i:]
            break
        if word == "--":
            continue
        for at, char in enumerate(word[1:], 1):
            flags.add(char)
            if char in VALUE:
                tail = word[at + 1:]
                if not tail and i < len(args):
                    tail = args[i]
                    i += 1
                if char == "o":
                    options.append(tail)
                break
    return flags, options, bare


def verdict(program, args):
    """What to make of this invocation: (RISKY, why), (SAFE, "") or (UNSURE, why)."""
    if program == "ssh-copy-id":
        return RISKY, "installs a key on the remote host"
    if program != "ssh":
        return SAFE, ""
    flags, options, bare = scan(args)
    if "R" in flags:
        return RISKY, "opens a listener on the remote host"
    for option in options:
        key = option.split("=", 1)[0].strip().lower()
        if key in LIMITS:
            return RISKY, "changes how the connection is made"
    if len(bare) > 1:
        said = DUP.sub("", " ".join(bare[1:]))
        words = said.split()
        if ">" in said:
            return RISKY, "writes a file where it lands"
        if words and words[0] in READ:
            return SAFE, ""
        if words and words[0] in CHANGE:
            asking = words[1].split("-")[0] if len(words) > 1 else ""
            if asking not in REPORT:
                return RISKY, "changes the remote host"
        return UNSURE, "runs a command on the remote host"
    return SAFE, ""


def words(command, at):
    """The words of the ssh call starting at `at`."""
    text, kept, quote, i = command[at:], [], "", 0
    while i < len(text):
        char = text[i]
        if quote:
            quote = "" if char == quote else quote
        elif char in "'\"":
            quote = char
        elif char in ";&|\n":
            break
        elif DUP.match(text, i):
            i = DUP.match(text, i).end()
            continue
        kept.append(char)
        i += 1
    said = "".join(kept)
    try:
        return shlex.split(said)
    except ValueError:      # a quote opened outside this call
        return said.replace("'", "").replace('"', "").split()


def secrets():
    """The `KEY=value` pairs the judgment tool expects, quotes stripped."""
    env = {}
    try:
        with open(SECRETS) as file:
            for line in file:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    key, value = line.split("=", 1)
                    env[key.strip()] = value.strip().strip("'\"")
    except OSError:
        return {}
    return env


def judged(call):
    """Whether the endpoint calls this ssh call risky; None when it cannot say."""
    env = dict(secrets(), **os.environ)
    question = {
        "type": "choice",
        "instructions": f"Is this ssh call high-risk:\n{call}\n"
        "Answer gated when it changes or exposes something on the remote host, "
        "or opens lasting access to it; answer ungated when it only reads, "
        "queries config, or keeps a tunnel or session on this machine.",
        "criteria": {
            "gated": "it can change or expose the remote host",
            "ungated": "it cannot change the remote host",
        },
    }
    asked = {"state": {"call": call}, "questions": {"risk": question}}
    try:
        done = subprocess.run(
            [JUDGE],
            input=json.dumps(asked), capture_output=True, text=True,
            env=env, timeout=8,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    for word in done.stdout.split(None, 1)[:1]:
        if word in ("risk=gated", "risk=ungated"):
            return word == "risk=gated"
    return None


def snippet(command, hit):
    """The hit's own line, cut around the hit when the line is long."""
    begin = command.rfind("\n", 0, hit.start()) + 1
    end = command.find("\n", hit.start())
    line = command[begin:end if end >= 0 else len(command)]
    if len(line) <= 160:
        return line.strip()
    cut = max(0, hit.start() - begin - 60)
    return ("…" if cut else "") + line[cut:cut + 140].strip() + "…"


def allow(question):
    asked = {"id": 1, "op": "ask", "text": question, "options": ["allow", "deny"]}
    fd = os.environ.get("PI_EVENTS_FD")
    if fd is None:
        print("cannot ask: no PI_EVENTS_FD to put the question to")
        return 2
    # A socket, so no "r+": that wants a file it can seek. One end each way.
    fd = int(fd)
    with os.fdopen(os.dup(fd), "w", buffering=1) as to_pi:
        to_pi.write(json.dumps(asked) + "\n")
    with os.fdopen(os.dup(fd), "r") as from_pi:
        said = json.loads(from_pi.readline() or "{}")
    answer = (said.get("result") or {}).get("answer")
    if answer == "allow":
        return 0
    why = ((said.get("error") or {}).get("message")) or answer or "closed without an answer"
    print(f"the user did not allow it: {why}")
    return 2


def main():
    call = json.load(sys.stdin)
    command = (call.get("args") or {}).get("command") or ""
    for hit in SSH.finditer(command):
        said = words(command, hit.end())
        if not said:
            continue
        kind, why = verdict(hit.group(1), said)
        if kind == SAFE:
            continue
        if kind == UNSURE:
            call = " ".join([hit.group(0)] + (said or []))
            risky = judged(call)
            if risky is False:
                continue
            why += ", unjudged" if risky is None else ""
        return allow(f"Run ({why}): {snippet(command, hit)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
